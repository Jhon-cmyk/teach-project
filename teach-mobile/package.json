{
  "name": "teach-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:mobile": "vue-tsc --noEmit && vite build --mode mobile",
    "build:demo": "vue-tsc --noEmit && vite build --mode demo",
    "preview": "vite preview --host 0.0.0.0",
    "check:boundary": "node scripts/check-mobile-boundary.mjs",
    "check:boundary:generated": "node scripts/check-mobile-boundary.mjs --generated",
    "check:native-env": "node scripts/check-mobile-native-env.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npm run check:native-env && npm run build:mobile && npx cap sync android && npx cap open android",
    "cap:ios": "npm run check:native-env && npm run build:mobile && npx cap sync ios && npx cap open ios",
    "smoke:routes": "npm run build:demo && node scripts/smoke-mobile-routes.mjs",
    "smoke:render": "npm run build:demo && node scripts/smoke-mobile-render.mjs",
    "android:sync": "npm run build:mobile && npx cap sync android",
    "android:debug": "npm run check:native-env && npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:doctor": "powershell -ExecutionPolicy Bypass -File scripts/check-android-env.ps1",
    "android:bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-android-sdk.ps1",
    "verify:isolation": "powershell -ExecutionPolicy Bypass -File scripts/verify-isolation.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.1",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.4.1",
    "@capacitor/ios": "^7.4.1",
    "@capacitor/local-notifications": "^7.0.7",
    "axios": "^1.13.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.1",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.10"
  }
}
