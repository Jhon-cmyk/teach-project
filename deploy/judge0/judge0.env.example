# Copy this file to judge0.env.local and replace every placeholder.

# PostgreSQL
POSTGRES_USER=judge0
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=judge0

# Redis
REDIS_PASSWORD=<generate-a-strong-password>

# Judge0 Server and Worker
JUDGE0_BASE_URL=http://server:2358
JUDGE0_MAINTENANCE_MODE=0

# Leave empty only in an isolated local development environment.
AUTH_TOKEN=<generate-a-random-token>

# 62=Java(OpenJDK 17), 71=Python 3, 54=C++(GCC), 63=JavaScript(Node)
ALLOWED_LANGUAGES=62,71,54,63
