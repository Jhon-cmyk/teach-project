# Copy this file to .env for local use. Never commit the resulting .env file.

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teach_platform
DB_URL=jdbc:mysql://127.0.0.1:3306/teach_platform?useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# Backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8820
RUYI_UPLOAD_PATH=./files/
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
KNIFE4J_ENABLED=true
AUTH_TOKEN_TTL=900
AUTH_TOKEN_SECRET=
SESSION_TIMEOUT=30d
SESSION_COOKIE_MAX_AGE=30d

# Isolated test profile (populated automatically by Testcontainers)
TEST_DB_URL=
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_UPLOAD_PATH=./target/test-uploads/
TEST_CORS_ALLOWED_ORIGINS=http://localhost

# AI models
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_VISION_PROVIDER=openai-compatible
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_VISION_API_KEY=
AI_VISION_MODEL=qwen-vl-plus

# iFlytek virtual avatar (backend only)
XFYUN_AVATAR_ENABLED=false
XFYUN_AVATAR_SERVER_URL=wss://avatar.cn-huadong-1.xf-yun.com/v1/interact
XFYUN_AVATAR_APP_ID=
XFYUN_AVATAR_API_KEY=
XFYUN_AVATAR_API_SECRET=
XFYUN_AVATAR_SCENE_ID=
XFYUN_AVATAR_ID=110117017
XFYUN_AVATAR_NAME=朵朵
XFYUN_AVATAR_VOICE=x4_lingxiaoqi_oral

# iFlytek Spark knowledge base (backend only)
XFYUN_KNOWLEDGE_ENABLED=false
XFYUN_KNOWLEDGE_BASE_URL=https://chatdoc.xfyun.cn
XFYUN_KNOWLEDGE_APP_ID=
XFYUN_KNOWLEDGE_SECRET=
XFYUN_KNOWLEDGE_TOP_N=5
XFYUN_KNOWLEDGE_ES_TOP_N=5
XFYUN_KNOWLEDGE_MIN_SCORE=45
XFYUN_KNOWLEDGE_TIMEOUT=60s

# Aliyun ASR
ALIYUN_ASR_APP_KEY=
ALIYUN_ASR_ACCESS_KEY_ID=
ALIYUN_ASR_ACCESS_KEY_SECRET=

# Aliyun TTS
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_ACCESS_KEY_ID=
ALIYUN_TTS_ACCESS_KEY_SECRET=
ALIYUN_TTS_ENDPOINT=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts

# Aliyun OSS
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET_NAME=ruyi-teach-assets

# Optional Bilibili data import; paste the cookie only into your ignored .env.
BILIBILI_COOKIE=

# AI agent and supporting services
AI_AGENT_BASE_URL=http://localhost:5000
EXTERNAL_CLIENT_CONNECT_TIMEOUT=10s
EXTERNAL_CLIENT_READ_TIMEOUT=30s
EXTERNAL_CLIENT_AI_MODEL_TIMEOUT=5m
EXTERNAL_CLIENT_AI_AGENT_TIMEOUT=8m
EXTERNAL_CLIENT_JUDGE0_TIMEOUT=15s
EXTERNAL_CLIENT_REMOTE_RESOURCE_TIMEOUT=20s
EXTERNAL_CLIENT_MAX_RETRIES=1
AI_SERVER_ENV=dev
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=5000
AI_SERVER_DEBUG=false
AI_SERVER_CORS_ALLOWED_ORIGINS=http://localhost:5173
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=teach_prepare_docs
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
CODE_EXECUTOR_MODE=judge0

# Unified Docker Compose. Replace all changeme values in your ignored .env.
DOCKER_DB_NAME=teach_platform
DOCKER_DB_USERNAME=teach
DOCKER_DB_PASSWORD=changeme
DOCKER_DB_ROOT_PASSWORD=changeme
DOCKER_MYSQL_PORT=3306
DOCKER_QDRANT_HTTP_PORT=6333
DOCKER_QDRANT_GRPC_PORT=6334
DOCKER_BACKEND_PORT=8820
DOCKER_AI_PORT=5000
DOCKER_FRONTEND_PORT=8080
DOCKER_SESSION_COOKIE_SECURE=false
DOCKER_JUDGE0_BASE_URL=http://host.docker.internal:2358
