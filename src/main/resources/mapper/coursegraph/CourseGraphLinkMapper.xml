<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruyi.teach.mapper.CourseGraphLinkMapper">

    <select id="selectActiveLinks" resultType="com.ruyi.teach.model.entity.CourseGraphLink">
        select
            id,
            source,
            target,
            relationType,
            description,
            sortOrder,
            createTime,
            updateTime,
            isDelete
        from course_graph_link
        where isDelete = 0
        order by sortOrder asc, id asc
    </select>

</mapper>
