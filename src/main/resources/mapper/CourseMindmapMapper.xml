<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruyi.teach.mapper.CourseMindmapMapper">

    <resultMap id="BaseResultMap" type="com.ruyi.teach.model.entity.CourseMindmap">
        <id property="id" column="id"/>
        <result property="courseId" column="course_id"/>
        <result property="title" column="title"/>
        <result property="mindmapJson" column="mindmap_json"/>
        <result property="sourceHash" column="source_hash"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDelete" column="isDelete"/>
    </resultMap>

    <select id="selectByCourseId" resultMap="BaseResultMap">
        SELECT
            id,
            course_id,
            title,
            mindmap_json,
            source_hash,
            status,
            created_at,
            updated_at,
            isDelete
        FROM course_mindmap
        WHERE course_id = #{courseId}
          AND isDelete = 0
        LIMIT 1
    </select>

    <insert id="upsert" parameterType="com.ruyi.teach.model.entity.CourseMindmap">
        INSERT INTO course_mindmap
        (
            course_id,
            title,
            mindmap_json,
            source_hash,
            status,
            created_at,
            updated_at,
            isDelete
        )
        VALUES
            (
                #{courseId},
                #{title},
                #{mindmapJson},
                #{sourceHash},
                #{status},
                NOW(),
                NOW(),
                0
            )
        ON DUPLICATE KEY UPDATE
                             title = VALUES(title),
                             mindmap_json = VALUES(mindmap_json),
                             source_hash = VALUES(source_hash),
                             status = VALUES(status),
                             updated_at = NOW(),
                             isDelete = 0
    </insert>

</mapper>